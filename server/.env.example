# Copy to server/.env (gitignored) or export these directly in the shell that
# starts pm2. LITELLM_API_KEY is a secret — never commit it, never put it in
# docusaurus.config.ts or anything that ends up in the browser bundle.

# Required. A virtual key minted in the LiteLLM admin UI at ai.loyalty.lt,
# scoped to this service (its own budget/rate limit), not the master key.
LITELLM_API_KEY=

# Optional — defaults shown are the production values (see ecosystem.config.cjs).
# AI_BASE_URL=https://ai.loyalty.lt
# AI_MODEL=qwen3-30b-a3b
# CHAT_PROXY_PORT=3102
# CHAT_PROXY_ALLOWED_ORIGINS=https://docs.loyalty.lt
