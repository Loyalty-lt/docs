# "Ask AI" chat — same AI gateway convention as api.loyalty.lt (config/services.php `ai`).
# Server-side only, never exposed to the browser.
AI_BASE_URL=https://ai.loyalty.lt/v1
AI_API_KEY=
AI_MODEL_STANDARD=chat-smart
AI_TENANT_MARKER=loyalty-docs
AI_EMBED_MODEL=embedding
# Off-topic gate: min doc-cosine to answer (below = canned "Loyalty.lt only" reply)
AI_RELEVANCE_THRESHOLD=0.65
