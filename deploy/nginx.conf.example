# nginx site config for docs.loyalty.lt
#
# Matches the other loyalty.lt front-ends: pm2 runs the app on a local port and
# nginx reverse-proxies to it. Here the app is `docusaurus serve` on 3098 (see
# ecosystem.config.cjs), serving the pre-built static site.
#
# Install:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/docs.loyalty.lt
#   sudo ln -s /etc/nginx/sites-available/docs.loyalty.lt /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d docs.loyalty.lt
#   sudo nginx -t && sudo systemctl reload nginx

upstream docs_loyalty {
    server 127.0.0.1:3098;
    keepalive 32;
}

# Ask AI page's proxy (server/chat-proxy.mjs). Separate process because it,
# alone, holds the ai.loyalty.lt credential — never the browser.
upstream docs_loyalty_chat {
    server 127.0.0.1:3102;
}

server {
    listen 80;
    listen [::]:80;
    server_name docs.loyalty.lt;

    # certbot rewrites this block; until then it just redirects.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name docs.loyalty.lt;

    # Managed by certbot.
    ssl_certificate     /etc/letsencrypt/live/docs.loyalty.lt/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/docs.loyalty.lt/privkey.pem;

    charset utf-8;

    # --- security headers -------------------------------------------------
    add_header X-Content-Type-Options    "nosniff"            always;
    add_header X-Frame-Options           "SAMEORIGIN"         always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # --- static assets ----------------------------------------------------
    # Docusaurus fingerprints everything under /assets/, so it is safe to cache
    # for a year. Served straight off disk to keep it off the node process.
    location /assets/ {
        alias /var/www/vhosts/loyalty.lt/docs.loyalty.lt/build/assets/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri @app;
    }

    # The OpenAPI spec is fetched by external tooling (Postman imports, codegen),
    # so it needs CORS and a short cache.
    location = /api-reference/openapi.json {
        alias /var/www/vhosts/loyalty.lt/docs.loyalty.lt/build/api-reference/openapi.json;
        add_header Access-Control-Allow-Origin "*";
        add_header Cache-Control "public, max-age=300";
        default_type application/json;
    }

    # --- chat proxy ---------------------------------------------------------
    location /api/chat {
        proxy_pass http://docs_loyalty_chat;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 35s;
    }

    # --- app --------------------------------------------------------------
    location / {
        try_files /dev/null @app;
    }

    location @app {
        proxy_pass http://docs_loyalty;
        proxy_http_version 1.1;
        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;

        # HTML must not be cached hard, or a deploy leaves stale pages behind.
        add_header Cache-Control "public, max-age=0, must-revalidate";
    }

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    access_log /var/log/nginx/docs.loyalty.lt.access.log;
    error_log  /var/log/nginx/docs.loyalty.lt.error.log;
}
